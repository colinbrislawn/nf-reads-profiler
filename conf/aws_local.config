// aws_local — run the AWS pipeline entirely on THIS node (local executor +
// local Docker), while reading inputs/per-sample outputs from S3 and writing
// merged outputs back to S3. Same I/O as the `aws` profile; only the executor
// and container registry change.
//
// Purpose: with skipCompleted=true and every sample's per-sample outputs already
// published, all samples skip at ingest and ONLY the study-level combine/reduce
// tasks run (no profiling, no kraken) — light enough to run locally. This proves
// PR #7's re-injection rebuilds the fully-merged combined tables from published
// per-sample files end-to-end, without a Batch cluster.
//
// ⚠ Any sample WITHOUT published outputs will NOT skip and will try to profile
//   locally (download FASTQ from S3 + run HUMAnN/MetaPhlAn/Kraken2 with the DBs
//   below). For a combine-only local run, point --input at a samplesheet that
//   contains only already-published samples.
//
// ⚠ outdir is the production results prefix (inherited from aws_batch.config).
//   The combine tasks publish merged tables there, overwriting any existing
//   combined_tables/ and medi/food_*.csv for the run. Override --outdir to a
//   scratch prefix if you don't want to touch production results — but then the
//   per-sample files output_exists() reads must also live under that prefix.

includeConfig 'aws_batch.config'   // S3 input/outdir, aws client, MEDI paths

// Local workdir (S3 bucketDir is awsbatch-only; unused under the local executor)
workDir = '/mnt/scratch/work-divlocal'

params {
    // Public images — the ECR mirrors in aws_batch.config need ECR auth to pull;
    // this node pulls from Docker Hub / GHCR instead.
    docker_container_humann4   = 'barbarahelena/humann:4.0.3'
    docker_container_metaphlan = 'colinbrislawn/metaphlan:4.2.4'
    docker_container_multiqc   = 'ghcr.io/multiqc/multiqc:v1.22.3'
    docker_container_fastp     = 'getwilds/fastp:1.1.0'
    docker_container_aws       = 'colinbrislawn/aws-cli-bash:2'
    docker_container_sra       = 'colinbrislawn/sra-tools-bash:3.0.7'
    docker_container_medi      = 'colinbrislawn/medi:0.2.1'

    // DBs on the local SSD RAID (only touched if a sample unexpectedly profiles;
    // an all-skip combine-only run needs none of these). MEDI db paths are already
    // local in aws_batch.config.
    direct_metaphlan_db = '/mnt/scratch/ssddbs/metaphlan_databases/vJan25/'
    humann_metaphlan_db = '/mnt/scratch/ssddbs/metaphlan_databases/vOct22/'
    humann_chocophlan   = '/mnt/scratch/ssddbs/chocophlan_v4_alpha/'
    humann_uniref       = '/mnt/scratch/ssddbs/uniref90_annotated_v4_alpha_ec_filtered/'
    humann_utilitymap   = '/mnt/scratch/ssddbs/full_mapping_v4_alpha/'

    mapping = false   // PR #7 guard: incompatible with skipCompleted
    // skipCompleted defaults true (nextflow.config)
}

// Everything runs locally in Docker on this node (overrides the awsbatch default
// and the per-process awsbatch assignments from aws_batch.config).
process {
    executor = 'local'

    // The combine/split/biom tasks only set executor=local in aws_batch.config and
    // otherwise inherit the 8.GB default. Bump them to 60 GB for the full-study
    // merge (under the 64 GB resourceLimits cap). This box has 497 GB, so the few
    // local combine tasks have plenty of headroom.
    withName: 'combine_humann_tables|combine_humann_taxonomy_tables|combine_metaphlan_tables|split_stratified_tables|convert_tables_to_biom|regroup_genefamilies' {
        memory = 60.GB
    }
}

// Local executor flow control (replaces the Batch queueSize=200). Combine/reduce
// tasks are few (per study × type) but each stages many small files from S3.
executor {
    queueSize = 8
}
