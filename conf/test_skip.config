// Local skipCompleted regression test — MEDI cohort (PR #7).
//
// Exercises the skipCompleted re-injection fix end-to-end against a REAL cohort:
// the 16-sample medi-food-hits-child run (project medi-20260515-213435, study
// SRP662258). All 16 samples' per-sample outputs already exist (published in S3),
// so on this run every sample is branched out at ingest (input_ch.skip) and must
// be re-injected into the study-level combines — the exact case PR #7 fixes.
//
// Strategy: STAGE published outputs -> ALL-SKIP. Sync the 16 published per-sample
// files from S3 into outdir first (see "Staging" below), then run normally:
//   - all 16 hit output_exists() -> skip (no kraken / HUMAnN re-run)
//   - PR #7 re-injects each skipped sample (HUMAnN TSVs, MetaPhlAn biom, Bracken .b2)
//   - only the combine/reduce tasks run -> verify all 16 land in the combined tables
// Wall time: ~minutes. Tests the re-injection + combine wiring, not fresh profiling.
//
// Pre-PR-7 (bug): combined food/tables truncate to 0 freshly-run samples.
// With PR #7: combined tables contain all 16 samples.
//
// This box = 512 GB RAM, all DBs on the /mnt/scratch/ssddbs RAID (incl. medi_db).
//
// ── Staging (run once before the test) ──────────────────────────────────────
//   RUN=s3://gutz-nf-reads-profilers-runs/results/medi-20260515-213435/SRP662258
//   DST=/mnt/scratch/test-skip-out/medi-20260515-213435/SRP662258
//   aws s3 cp "$RUN/function/" "$DST/function/" --recursive --exclude '*' \
//     --include '*_1_metaphlan_profile.tsv' --include '*_2_genefamilies.tsv' \
//     --include '*_3_reactions.tsv' --include '*_4_pathabundance.tsv' --region us-east-2
//   aws s3 cp "$RUN/taxa/" "$DST/taxa/" --recursive --exclude '*' \
//     --include '*_metaphlan.biom' --region us-east-2
//   aws s3 cp "$RUN/medi/bracken/" "$DST/medi/bracken/" --recursive \
//     --include '*.b2' --region us-east-2
//
// ── Run ─────────────────────────────────────────────────────────────────────
//   screen -S nf-skip
//   nextflow run main.nf -profile test_skip          # skipCompleted=true by default
//
// MEDI hash need not be warmed: no kraken task should run (all samples skip). It is
// only touched if output_exists() unexpectedly misses a sample.

includeConfig 'test.config'

workDir = '/mnt/scratch/work-skip'

// test.config caps every process at 8 GB — too small for bowtie2 against the real
// vOct22/vJan25 MetaPhlAn indexes if any profiling task unexpectedly runs. Give the
// profiling steps real memory and serialize so we stay well under this box's 497 GB.
executor {
    queueSize = 4
}
process {
    withName: 'profile_taxa' {
        cpus   = 8
        memory = 38.GB
    }
    withName: 'profile_function' {
        cpus   = 8
        memory = 60.GB
    }
    // Safety net only — kraken should not run in an all-skip test. The hash is
    // already warm in the page cache (vmtouch -dl), so no beforeScript prewarm
    // and a short 2 min limit are fine.
    withName: 'MEDI_QUANT:kraken' {
        cpus          = 8
        maxForks      = 1
        time          = 2.m
        errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
        maxRetries    = 1
    }
}

params {
    // 16-sample SRA cohort (study_accession SRP662258).
    input      = "$projectDir/assets/samplesheet-medi-food-hits-child.csv"
    // Reuse the production project/run name so output_exists() finds the staged
    // per-sample files under outdir/<project>/<run>/.
    outdir     = "/mnt/scratch/test-skip-out"
    project    = "medi-20260515-213435"

    enable_medi = true
    skipHumann  = false   // MEDI needs HUMAnN unmapped reads; also exercises HUMAnN re-injection
    mapping     = false   // required: params.mapping is incompatible with skipCompleted (PR #7 guard)

    // Real MetaPhlAn + HUMAnN4 DBs on the scratch RAID (override test.config's toy DBs).
    direct_metaphlan_id = "mpa_vJan25_CHOCOPhlAnSGB_202503"
    direct_metaphlan_db = "/mnt/scratch/ssddbs/metaphlan_databases/vJan25/"
    humann_metaphlan_id = "mpa_vOct22_CHOCOPhlAnSGB_202403"
    humann_metaphlan_db = "/mnt/scratch/ssddbs/metaphlan_databases/vOct22/"
    humann_chocophlan   = "/mnt/scratch/ssddbs/chocophlan_v4_alpha/"
    humann_uniref       = "/mnt/scratch/ssddbs/uniref90_annotated_v4_alpha_ec_filtered/"
    humann_utilitymap   = "/mnt/scratch/ssddbs/full_mapping_v4_alpha/"

    // MEDI DB — local SSD scratch (matches test_medi.config / nextflow.config defaults).
    medi_db_path       = '/mnt/scratch/ssddbs/medi_db/'
    medi_food_matches  = '/mnt/scratch/ssddbs/medi_db/food_matches.csv'
    medi_food_contents = '/mnt/scratch/ssddbs/medi_db/food_contents.csv.gz'

    // MEDI needs the Diamond translated search to produce unaligned reads (do NOT
    // bypass it). Only relevant if a sample unexpectedly re-runs.
    humann_extraparams = ""
}

// Re-enable reports (test.config disables them).
report.enabled = true
trace.enabled  = true

// Keep work dir + outputs so the staged files survive and a -resume can re-run.
cleanup = false
